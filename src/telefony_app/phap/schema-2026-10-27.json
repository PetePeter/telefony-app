{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PetePeter/phone-agent-protocol/schema/2026-10-27/schema.json",
  "title": "Phone Agent Protocol 2026-10-27",
  "$defs": {
    "ProtocolVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "Implementation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "instanceId": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Role": {
      "enum": [
        "controller",
        "observer"
      ]
    },
    "CallStateName": {
      "enum": [
        "ringing",
        "dialing",
        "alerting",
        "active",
        "held",
        "ended"
      ]
    },
    "EndReason": {
      "enum": [
        "local",
        "remote",
        "rejected",
        "busy",
        "failed",
        "fallback",
        "link_lost"
      ]
    },
    "CallInfo": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "inbound",
            "outbound"
          ]
        },
        "state": {
          "$ref": "#/$defs/CallStateName"
        }
      },
      "required": [
        "callId",
        "number",
        "direction",
        "state"
      ]
    },
    "State": {
      "type": "object",
      "properties": {
        "link": {
          "enum": [
            "up",
            "down"
          ]
        },
        "engine": {
          "enum": [
            "starting",
            "ready",
            "stopped",
            "error"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallInfo"
          }
        }
      },
      "required": [
        "link",
        "engine",
        "calls"
      ]
    },
    "ServerCapabilities": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "object"
        },
        "conference": {
          "type": "object"
        },
        "sms": {
          "type": "object"
        },
        "contacts": {
          "type": "object"
        },
        "heartbeat": {
          "type": "object"
        },
        "voice": {
          "type": "object",
          "properties": {
            "tts": {
              "type": "boolean"
            },
            "stt": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "JSONRPCRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ]
    },
    "JSONRPCResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "result": {
          "type": "object"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "result"
          ]
        },
        {
          "required": [
            "error"
          ]
        }
      ]
    },
    "JSONRPCNotification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "event"
        },
        "params": {
          "$ref": "#/$defs/Event"
        }
      },
      "required": [
        "jsonrpc",
        "method",
        "params"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorCode": {
      "enum": [
        -32700,
        -32600,
        -32601,
        -32602,
        -32603,
        -32001,
        1001,
        1002,
        1003,
        1004,
        1005,
        1006,
        1007,
        1008
      ]
    },
    "MessageSummary": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "preview": {
          "type": "string",
          "maxLength": 160
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "handle",
        "number",
        "preview",
        "ts"
      ]
    },
    "Contact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "number"
            ]
          }
        }
      },
      "required": [
        "name",
        "numbers"
      ]
    },
    "CallLogEntry": {
      "type": "object",
      "properties": {
        "direction": {
          "enum": [
            "missed",
            "received",
            "dialed"
          ]
        },
        "number": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "direction",
        "number",
        "ts"
      ]
    },
    "TranscriptEntry": {
      "type": "object",
      "properties": {
        "speaker": {
          "enum": [
            "remote",
            "local"
          ]
        },
        "text": {
          "type": "string"
        },
        "startMs": {
          "type": "integer"
        },
        "endMs": {
          "type": "integer"
        }
      },
      "required": [
        "speaker",
        "text",
        "startMs",
        "endMs"
      ]
    },
    "HelloParams": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "token": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "clientInfo": {
          "$ref": "#/$defs/Implementation"
        },
        "resumeFrom": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "protocolVersion",
        "token",
        "role",
        "clientInfo"
      ]
    },
    "HelloResult": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "serverInfo": {
          "$ref": "#/$defs/Implementation"
        },
        "capabilities": {
          "$ref": "#/$defs/ServerCapabilities"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "lastSeq": {
          "type": "integer"
        },
        "gap": {
          "type": "boolean"
        }
      },
      "required": [
        "protocolVersion",
        "serverInfo",
        "capabilities",
        "role",
        "state",
        "lastSeq",
        "gap"
      ]
    },
    "HelloRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/JSONRPCRequest"
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "hello"
            },
            "params": {
              "$ref": "#/$defs/HelloParams"
            }
          },
          "required": [
            "method",
            "params"
          ]
        }
      ]
    },
    "CallDialParams": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "string"
            }
          },
          "required": [
            "number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "contact": {
              "type": "string"
            }
          },
          "required": [
            "contact"
          ]
        }
      ]
    },
    "CallDialResult": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string"
        }
      },
      "required": [
        "callId"
      ]
    },
    "CallDialRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/JSONRPCRequest"
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "call.dial"
            },
            "params": {
              "$ref": "#/$defs/CallDialParams"
            }
          },
          "required": [
            "method",
            "params"
          ]
        }
      ]
    },
