      "type": "object",
      "properties": {}
    },
    "CallHoldRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/JSONRPCRequest"
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "call.hold"
            },
            "params": {
